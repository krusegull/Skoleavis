# Database (Neon Postgres). Bruk "pooled" connection string fra Neon-dashbordet.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon gir også en "direct"/unpooled URL - brukes av Prisma migrate.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer-med-openssl-rand-base64-32"

# Feide (valgfritt - la stå tomt til skolen har godkjent en OIDC-klient).
# Så lenge disse er tomme, vises ikke Feide-knappen og appen fungerer som normalt.
FEIDE_CLIENT_ID=""
FEIDE_CLIENT_SECRET=""
FEIDE_ISSUER="https://auth.dataporten.no"

# Claude API (for "Foreslå teaser" og ukentlige nyhetstips). Kun brukt
# server-side, aldri eksponert i klienten.
ANTHROPIC_API_KEY=""
ANTHROPIC_TIPS_MODEL=""

# Beskytter /api/cron/news-tips slik at bare Vercels egen cron-jobb kan
# trigge det ukentlige nyhetssøket. Generer med: openssl rand -base64 32
CRON_SECRET=""

# Cloudinary (for "Last opp bilde"). Gratis konto på cloudinary.com - alle tre
# verdiene vises rett på forsiden av dashbordet ditt der.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudinary, usignert opplasting fra nettleseren (for /send-inn - elever og
# andre laster opp dokumenter/bilder direkte, uten innlogging). Samme
# cloud name som over, pluss en "unsigned upload preset" du oppretter i
# Cloudinary-konsollet. Se README "Innsending fra elever" for stegene.
# NB: disse er ment å være synlige i nettleseren (derfor NEXT_PUBLIC_) -
# ikke sett hemmeligheter her.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
