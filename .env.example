# Database (Neon Postgres). Bruk "pooled" connection string fra Neon-dashbordet.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon gir også en "direct"/unpooled URL - brukes av Prisma migrate.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer-med-openssl-rand-base64-32"

# Feide (valgfritt - la stå tomt til skolen har godkjent en OIDC-klient).
# Så lenge disse er tomme, vises ikke Feide-knappen og appen fungerer som normalt.
FEIDE_CLIENT_ID=""
FEIDE_CLIENT_SECRET=""
FEIDE_ISSUER="https://auth.dataporten.no"

# Claude API (for "Foreslå teaser"). Kun brukt server-side, aldri eksponert i klienten.
ANTHROPIC_API_KEY=""
