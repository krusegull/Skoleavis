// Skoleavis - databaseskjema
// Se README.md for forklaring av rolle-/skoleårsmodellen.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  JOURNALIST
  PHOTOGRAPHER
  DESIGNER
  SOCIAL_MEDIA
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum Category {
  NEWS
  REPORTAGE
  INTERVIEW
  REVIEW
  SPORT
  CULTURE
  WEEKLY_PICK
  HISTORICAL_NEWS
  COMPETITION
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

enum LocalActivityCategory {
  SPORT
  LEISURE_CLUB
  CULTURE
  LIBRARY
  OTHER
}

// --- NextAuth (standard Prisma-adapter-modeller) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Brukere og roller ---

/// En konto. Rolle ligger IKKE her - se RoleAssignment.
/// Kontoer deaktiveres (active = false), slettes aldri, slik at
/// historikk og bylines i arkivet forblir korrekte.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // null for rene OAuth-brukere (f.eks. fremtidig Feide)
  image        String?
  active       Boolean  @default(true)
  /// Skjuler kontoen fra den offentlige Redaksjonen-siden, uavhengig av
  /// rolle (en Journalist/Fotograf kan være elev eller voksen). Brukes for
  /// å holde elevnavn borte fra offentlig visning som standard.
  isStudent    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  roleAssignments RoleAssignment[]

  articlesAuthored Article[]            @relation("ArticleAuthor")
  articlesReviewed Article[]            @relation("ArticleReviewer")
  contributions    ArticleContributor[]
}

/// Ett skoleår/kull, f.eks. "2026/2027". Styrer hvilken redaksjon
/// som vises som "gjeldende" og brukes av "Avslutt skoleår".
model SchoolYear {
  id        String    @id @default(cuid())
  label     String    @unique
  isCurrent Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  roleAssignments RoleAssignment[]

  @@index([isCurrent])
}

/// Kobler en bruker til en rolle for ett bestemt skoleår.
/// En bruker kan ha ulik rolle (eller ingen) fra år til år, og
/// Admin-rollen overføres ganske enkelt ved å opprette en ny
/// tildeling for en annen bruker.
model RoleAssignment {
  id           String   @id @default(cuid())
  userId       String
  role         Role
  schoolYearId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolYearId])
  @@index([schoolYearId, role])
}

// --- Innhold ---

/// En sak/artikkel.
model Article {
  id              String        @id @default(cuid())
  title           String
  ingress         String
  teaser          String?
  body            String
  imageUrl        String?
  category        Category
  status          ArticleStatus @default(DRAFT)
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  /// Sant dersom brødteksten (helt eller delvis) ble skrevet av AI-agenten
  /// ut fra et nyhetstips. Vises som et tydelig varsel i redigeringsvisningen
  /// - må alltid faktasjekkes og redigeres av et menneske før godkjenning.
  aiDrafted       Boolean       @default(false)

  authorId     String
  reviewedById String?

  author     User  @relation("ArticleAuthor", fields: [authorId], references: [id])
  reviewedBy User? @relation("ArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  contributors ArticleContributor[]
  newsTips     NewsTip[]

  @@index([status, publishedAt])
  @@index([category, status])
}

/// Innholdet på "Om oss"-siden. Én rad (fast id "about"), redigeres fra
/// dashbordet av Admin/Redaktør. Opprettes med standardtekst ved første
/// visning dersom den ikke finnes ennå.
model AboutPage {
  id        String   @id @default("about")
  title     String   @default("Om Stuanytt")
  body      String   @default("")
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

/// Et nyhetstips foreslått av AI-agenten (daglig nettsøk). Kun et forslag
/// til vinkling/kilde for redaksjonen - ALDRI ferdig artikkeltekst, siden
/// agenten ikke har lov til å gjengi andres journalistikk. Synlig kun for
/// Redaktør/Admin, som enten oppretter en original sak basert på tipset
/// eller avviser det.
model NewsTip {
  id         String    @id @default(cuid())
  title      String
  summary    String
  sourceUrl  String
  sourceName String?
  category   Category?
  dismissed  Boolean   @default(false)
  articleId  String? // satt hvis redaktøren opprettet en sak fra tipset
  createdAt  DateTime  @default(now())

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([sourceUrl])
  @@index([dismissed, createdAt])
}

/// Et bidrag sendt inn av en elev eller andre via det offentlige
/// innsendingsskjemaet (/send-inn) - ikke krever innlogging. Dokumentet
/// (Word/PDF e.l.) og eventuelle bilder lastes opp direkte fra nettleseren
/// til Cloudinary og lagres kun som URL-er her. Redaktør/Admin ser disse
/// under Dashbord -> Innsendinger og skriver selv innholdet inn som en
/// ordentlig sak dersom den skal publiseres.
model Submission {
  id           String           @id @default(cuid())
  name         String
  email        String?
  message      String?
  documentUrl  String
  documentName String
  imageUrls    String[]         @default([])
  status       SubmissionStatus @default(NEW)
  createdAt    DateTime         @default(now())

  @@index([status, createdAt])
}

/// En avstemning på siden, f.eks. "Hvem vinner Champions League?".
/// Opprettes/åpnes/lukkes av Redaktør/Admin. Rene tellinger mot faste
/// svaralternativer - ingen AI eller betalt tjeneste involvert, så dette
/// koster ingenting ekstra uansett hvor mange som stemmer.
model Poll {
  id        String       @id @default(cuid())
  question  String
  isOpen    Boolean      @default(true)
  createdAt DateTime     @default(now())

  options PollOption[]
  votes   Vote[]
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int    @default(0)

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

/// Én stemme. `voterKey` er en tilfeldig verdi lagret i en cookie hos den
/// som stemmer (satt av API-ruta, ikke lesbar/forfalskbar av vanlig
/// klient-JS) - kombinert med den unike indeksen hindrer dette at samme
/// nettleser stemmer flere ganger på samme avstemning. Ikke vanntett (rydder
/// man cookies kan man stemme på nytt), men trenger ikke innlogging og
/// koster ingenting - et bevisst, dokumentert kompromiss for en skoleavis.
model Vote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  voterKey  String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterKey])
  @@index([optionId])
}

/// Et fritidstilbud i nærområdet (idrettslag, fritidsklubb, kultur- eller
/// bibliotektilbud osv.) - en kuratert lenkekatalog, ikke en artikkel. Kort
/// tekst her på siden, med en lenke videre til tilbudets egen nettside.
/// Redaktør/Admin legger inn og vedlikeholder disse fra dashbordet - ingen
/// fast oppdateringsfrekvens.
model LocalActivity {
  id          String                @id @default(cuid())
  name        String
  description String
  ageRange    String?
  category    LocalActivityCategory
  externalUrl String
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([category, sortOrder])
}

/// Bidragsyter/byline på en sak. Navn og rolle lagres som tekst
/// (snapshot) i tillegg til en valgfri kobling til kontoen, slik at
/// bylines i arkivet er korrekte selv om kontoen senere deaktiveres.
model ArticleContributor {
  id           String  @id @default(cuid())
  articleId    String
  userId       String?
  nameSnapshot String
  roleSnapshot Role
  sortOrder    Int     @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
}
